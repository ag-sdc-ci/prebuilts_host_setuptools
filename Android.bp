package {
    default_applicable_licenses: ["external_python_setuptools_license"],
}

license {
    name: "external_python_setuptools_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD",
        "SPDX-license-identifier-MIT",
    ],
    license_text: [
        "LICENSE",
    ],
}

python_library_host {
    name: "py-setuptools",
    srcs: [
        "setuptools/**/*.py",
        "pkg_resources/**/*.py",
        "_distutils_hack/**/*.py",
    ],
}

python_library_host {
    name: "setuptools",
    srcs: [
        "setuptools/**/*.py",
        "pkg_resources/**/*.py",
        "_distutils_hack/**/*.py",
    ],
}
